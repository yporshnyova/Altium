<!--
    Dark theme palette: the same semantic keys as Light.xaml (enforced by a unit test). Accent text is lighter than the
    accent button fill so both keep WCAG AA contrast on dark surfaces. Brushes are frozen: never modified.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
    mc:Ignorable="po">

    <!--  Surfaces  -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" po:Freeze="True" Color="#16191D" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" po:Freeze="True" Color="#1E2227" />
    <SolidColorBrush x:Key="CardBackgroundBrush" po:Freeze="True" Color="#1E2227" />
    <SolidColorBrush x:Key="CardBorderBrush" po:Freeze="True" Color="#343A42" />
    <SolidColorBrush x:Key="DividerBrush" po:Freeze="True" Color="#2C3239" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" po:Freeze="True" Color="#23282E" />

    <!--  Inputs  -->
    <SolidColorBrush x:Key="ControlBackgroundBrush" po:Freeze="True" Color="#15181C" />
    <SolidColorBrush x:Key="ControlBorderBrush" po:Freeze="True" Color="#5E6772" />
    <SolidColorBrush x:Key="ControlHoverBorderBrush" po:Freeze="True" Color="#8A94A0" />
    <SolidColorBrush x:Key="ControlFocusBorderBrush" po:Freeze="True" Color="#5B9BFF" />
    <SolidColorBrush x:Key="ControlDisabledBackgroundBrush" po:Freeze="True" Color="#23272C" />
    <SolidColorBrush x:Key="TextSelectionBrush" po:Freeze="True" Color="#5B9BFF" />
    <SolidColorBrush x:Key="SwatchBorderBrush" po:Freeze="True" Color="#8A94A0" />

    <!--  List and tab states  -->
    <SolidColorBrush x:Key="ItemHoverBackgroundBrush" po:Freeze="True" Color="#2B3440" />
    <SolidColorBrush x:Key="ItemSelectedBackgroundBrush" po:Freeze="True" Color="#1F3A5F" />
    <SolidColorBrush x:Key="TabHoverBackgroundBrush" po:Freeze="True" Color="#252B32" />

    <!--  Text  -->
    <SolidColorBrush x:Key="TextPrimaryBrush" po:Freeze="True" Color="#E6EAEF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" po:Freeze="True" Color="#A4AEB9" />
    <SolidColorBrush x:Key="TextDisabledBrush" po:Freeze="True" Color="#6B747F" />
    <SolidColorBrush x:Key="ErrorBrush" po:Freeze="True" Color="#FF8A80" />

    <!--  Accent and buttons  -->
    <SolidColorBrush x:Key="AccentBrush" po:Freeze="True" Color="#2F6FD0" />
    <SolidColorBrush x:Key="AccentHoverBrush" po:Freeze="True" Color="#3B7DE0" />
    <SolidColorBrush x:Key="AccentPressedBrush" po:Freeze="True" Color="#285FB3" />
    <SolidColorBrush x:Key="AccentTextBrush" po:Freeze="True" Color="#7FB2FF" />
    <SolidColorBrush x:Key="OnAccentTextBrush" po:Freeze="True" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonBorderBrush" po:Freeze="True" Color="#4A525C" />
    <SolidColorBrush x:Key="SecondaryHoverBrush" po:Freeze="True" Color="#2A3038" />
    <SolidColorBrush x:Key="SecondaryPressedBrush" po:Freeze="True" Color="#333A43" />

    <!--  Scroll bars  -->
    <SolidColorBrush x:Key="ScrollThumbBrush" po:Freeze="True" Color="#444C56" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" po:Freeze="True" Color="#5A6470" />

</ResourceDictionary>
