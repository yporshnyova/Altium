<!--
    Shared layout: spacing tokens and the surfaces every screen is built from (cards, footer bar, dividers, swatches).
    All colours come from the theme palette (Resources/Themes) through DynamicResource.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Spacing: 20 around the page and inside cards, 16 between cards and between the two columns.  -->
    <Thickness x:Key="PageMargin">20</Thickness>
    <Thickness x:Key="FieldMargin">0,0,0,14</Thickness>
    <!--  Every card ends with an element carrying the 14 bottom field margin, so 6 + 14 = 20 at the bottom.  -->
    <Thickness x:Key="CardPadding">20,20,20,6</Thickness>
    <Thickness x:Key="CardGapMargin">0,0,0,16</Thickness>
    <GridLength x:Key="ColumnGap">16</GridLength>
    <Thickness x:Key="FooterPadding">20,12</Thickness>

    <!--  Containers  -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <!--  Fixed action bar below the scrolling content: same surface as the cards, separated by a top rule.  -->
    <Style x:Key="FooterBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="{StaticResource FooterPadding}" />
    </Style>

    <Style x:Key="DividerStyle" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,4,0,14" />
        <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
    </Style>

    <Style x:Key="ColorSwatchStyle" TargetType="Border">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource SwatchBorderBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
