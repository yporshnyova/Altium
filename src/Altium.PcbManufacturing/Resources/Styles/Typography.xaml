<!--
    Shared typography: section headers, hints and the label/value pairs of the summaries on every tab, plus the one
    summary value shared by several steps, which binds to the step's Draft.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Altium.PcbManufacturing.Views.Converters"
    xmlns:loc="clr-namespace:Altium.PcbManufacturing.Views.Markup">

    <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style x:Key="HintTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,-8,0,14" />
    </Style>

    <!--  Summaries  -->
    <Style x:Key="SummarySectionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Margin" Value="0,6,0,8" />
    </Style>

    <Style x:Key="SummaryLabelTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,16,10" />
    </Style>

    <Style x:Key="SummaryValueTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style
        x:Key="SummaryTotalLabelTextStyle"
        BasedOn="{StaticResource SummaryLabelTextStyle}"
        TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style
        x:Key="SummaryTotalValueTextStyle"
        BasedOn="{StaticResource SummaryValueTextStyle}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>

    <!--
        Material surcharge per board as a summary value: "+$37.25", or "Included" when there is none. Used by the
        Preferences summary and the Quote estimate; bound to the step's Draft (every step view model exposes it).
    -->
    <Style
        x:Key="MaterialSurchargeValueTextStyle"
        BasedOn="{StaticResource SummaryValueTextStyle}"
        TargetType="TextBlock">
        <Setter Property="Text" Value="{Binding Draft.PriceEstimate.MaterialSurchargePerUnit, Mode=OneWay, Converter={converters:UsdConverter}, StringFormat='+{0}'}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Draft.PriceEstimate.MaterialSurchargePerUnit, Mode=OneWay}" Value="0">
                <Setter Property="Text" Value="{loc:Text Pricing_Included}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
