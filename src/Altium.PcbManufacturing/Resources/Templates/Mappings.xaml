<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:Altium.PcbManufacturing.Views"
    xmlns:vm="clr-namespace:Altium.PcbManufacturing.ViewModels">

    <DataTemplate DataType="{x:Type vm:PreferencesViewModel}">
        <views:PreferencesView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:QuoteViewModel}">
        <views:QuoteView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:OrderViewModel}">
        <views:OrderView />
    </DataTemplate>

</ResourceDictionary>
