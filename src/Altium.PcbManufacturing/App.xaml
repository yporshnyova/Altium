<Application
    x:Class="Altium.PcbManufacturing.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  No StartupUri: MainWindow is resolved from the DI container in App.OnStartup.  -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  Theme palette first; ThemeService replaces it with Dark.xaml at runtime.  -->
                <ResourceDictionary Source="Resources/Themes/Light.xaml" />
                <ResourceDictionary Source="Resources/Styles/AppStyles.xaml" />
                <ResourceDictionary Source="Resources/Templates/Mappings.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
