<Application
    x:Class="Altium.PcbManufacturing.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  No StartupUri: MainWindow is resolved from the DI container in App.OnStartup.  -->
    <!--
        Application-wide resources only: the theme palette (swapped at runtime by ThemeService), shared styles and
        templates. Resources used by a single view live next to it (Views/*.Styles.xaml) and are merged by that view.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Themes/Dark.xaml" />
                <ResourceDictionary Source="Resources/Styles/Layout.xaml" />
                <ResourceDictionary Source="Resources/Styles/Typography.xaml" />
                <ResourceDictionary Source="Resources/Styles/Buttons.xaml" />
                <ResourceDictionary Source="Resources/Styles/Controls.xaml" />
                <ResourceDictionary Source="Resources/Templates/CatalogTemplates.xaml" />
                <ResourceDictionary Source="Resources/Templates/Mappings.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
