<!--
    MainWindow resources: the application header (title, language and theme controls), the workflow tab headers and
    the wizard's navigation footer. Merged through Window.Resources; shared button and control styles come from the
    application resources.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:loc="clr-namespace:Altium.PcbManufacturing.Views.Markup"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    xmlns:vm="clr-namespace:Altium.PcbManufacturing.ViewModels">

    <!--  Icon sizes  -->
    <system:Double x:Key="TabIconSize">18</system:Double>
    <system:Double x:Key="HeaderIconSize">20</system:Double>

    <!--  Application header above the tabs.  -->
    <Style x:Key="HeaderBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="20,8" />
    </Style>

    <Style x:Key="AppTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="HeaderIconStyle" TargetType="iconPacks:PackIconMaterial">
        <Setter Property="Width" Value="{StaticResource HeaderIconSize}" />
        <Setter Property="Height" Value="{StaticResource HeaderIconSize}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  Icon-only header action. Its accessible name and tooltip are set by the style for the specific action.  -->
    <Style
        x:Key="HeaderIconButtonStyle"
        BasedOn="{StaticResource ActionButtonStyle}"
        TargetType="Button">
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SecondaryHoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource SecondaryPressedBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  The icon shows the theme it switches to: a moon in light mode, a sun in dark mode.  -->
    <Style
        x:Key="ThemeToggleButtonStyle"
        BasedOn="{StaticResource HeaderIconButtonStyle}"
        TargetType="Button">
        <Setter Property="ToolTip" Value="{loc:Text Header_SwitchToDarkTheme}" />
        <Setter Property="AutomationProperties.Name" Value="{loc:Text Header_SwitchToDarkTheme}" />
        <Setter Property="Content">
            <Setter.Value>
                <iconPacks:PackIconMaterial Kind="WeatherNight" Style="{StaticResource HeaderIconStyle}" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                <Setter Property="ToolTip" Value="{loc:Text Header_SwitchToLightTheme}" />
                <Setter Property="AutomationProperties.Name" Value="{loc:Text Header_SwitchToLightTheme}" />
                <Setter Property="Content">
                    <Setter.Value>
                        <iconPacks:PackIconMaterial Kind="WhiteBalanceSunny" Style="{StaticResource HeaderIconStyle}" />
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  Workflow tabs  -->
    <Style x:Key="TabIconStyle" TargetType="iconPacks:PackIconMaterial">
        <Setter Property="Width" Value="{StaticResource TabIconSize}" />
        <Setter Property="Height" Value="{StaticResource TabIconSize}" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StepCompletedIconStyle" TargetType="iconPacks:PackIconMaterial">
        <Setter Property="Kind" Value="CheckCircleOutline" />
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        <Setter Property="ToolTip" Value="{loc:Text Workflow_StepCompleted}" />
        <Setter Property="Visibility" Value="Hidden" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  Preferences and Quote tabs (bound to the wizard): once the order is completed they explain why they are locked.  -->
    <Style
        x:Key="EditableStepTabItemStyle"
        BasedOn="{StaticResource {x:Type TabItem}}"
        TargetType="TabItem">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                <Setter Property="ToolTip" Value="{loc:Text Workflow_OrderCompleted}" />
                <Setter Property="AutomationProperties.HelpText" Value="{loc:Text Workflow_OrderCompleted}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  Navigation footer (bound to the wizard)  -->
    <Style
        x:Key="BackButtonStyle"
        BasedOn="{StaticResource SecondaryButtonStyle}"
        TargetType="Button">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsBackVisible}" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  Preferences has no Back; its Reset to Defaults takes that place.  -->
    <Style
        x:Key="ResetToDefaultsButtonStyle"
        BasedOn="{StaticResource SecondaryButtonStyle}"
        TargetType="Button">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static vm:WorkflowStep.Preferences}">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  Place Order and New Order lead with an icon; the other primary actions point forward.  -->
    <Style
        x:Key="PrimaryActionLeadingIconStyle"
        BasedOn="{StaticResource ButtonIconStyle}"
        TargetType="iconPacks:PackIconMaterial">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static vm:WorkflowStep.Order}">
                <Setter Property="Kind" Value="ClipboardCheckOutline" />
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                <Setter Property="Kind" Value="Plus" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style
        x:Key="PrimaryActionTrailingIconStyle"
        BasedOn="{StaticResource ButtonIconStyle}"
        TargetType="iconPacks:PackIconMaterial">
        <Style.Triggers>
            <DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static vm:WorkflowStep.Order}">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
