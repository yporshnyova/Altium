<UserControl
    x:Class="Altium.PcbManufacturing.Views.OrderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:loc="clr-namespace:Altium.PcbManufacturing.Views.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Altium.PcbManufacturing.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:OrderViewModel}"
    d:DesignHeight="640"
    d:DesignWidth="960"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer
            Grid.Row="0"
            Focusable="False"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid Margin="{StaticResource PageMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="400" />
                    <ColumnDefinition Width="{StaticResource ColumnGap}" />
                    <ColumnDefinition Width="2*" MinWidth="300" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Grid.ColumnSpan="3"
                    Margin="{StaticResource CardGapMargin}"
                    Padding="16,12"
                    AutomationProperties.LiveSetting="Polite"
                    AutomationProperties.Name="{loc:Text Order_PlacedTitle}"
                    Background="{DynamicResource ItemSelectedBackgroundBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOrderCompleted, Mode=OneWay}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <iconPacks:PackIconMaterial
                            Width="24"
                            Height="24"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource AccentTextBrush}"
                            Kind="CheckCircleOutline" />
                        <StackPanel Grid.Column="1">
                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                Text="{loc:Text Order_PlacedTitle}" />
                            <TextBlock
                                Margin="0,2,0,0"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="{loc:Text Order_PlacedMessage}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  the project, delivery and board, from the shared preferences.  -->
                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.ColumnSpan="2"
                            Style="{StaticResource SectionHeaderTextStyle}"
                            Text="{loc:Text Order_Summary}" />
                        <TextBlock 
                            Grid.Column="0"
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Style="{StaticResource HintTextStyle}"
                            Text="{loc:Text Order_ReviewHint}" />

                        <TextBlock
                            Grid.Column="0"
                            Grid.Row="2"
                            Grid.ColumnSpan="2"
                            Style="{StaticResource SummarySectionTextStyle}"
                            Text="{loc:Text Summary_Project}" />
                        <TextBlock
                            Grid.Column="0"
                            Grid.Row="3"
                            Style="{StaticResource SummaryLabelTextStyle}"
                            Text="{loc:Text Summary_ProjectName}" />
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="1"
                            Style="{StaticResource SummaryValueTextStyle}"
                            Text="{Binding ProjectName, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="0"
                            Grid.Row="4"
                            Style="{StaticResource SummaryLabelTextStyle}"
                            Text="{loc:Text Order_DeliveryPostcode}" />
                        <TextBlock
                            Grid.Row="4"
                            Grid.Column="1"
                            Style="{StaticResource SummaryValueTextStyle}"
                            Text="{Binding Postcode, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="0"
                            Grid.Row="5"
                            Style="{StaticResource SummaryLabelTextStyle}"
                            Text="{loc:Text Preferences_Notes}" />
                        <TextBlock
                            Grid.Row="5"
                            Grid.Column="1"
                            Text="{Binding NotesText, Mode=OneWay}">
                            <TextBlock.Style>
                                <Style BasedOn="{StaticResource SummaryValueTextStyle}" TargetType="TextBlock">
                                    <Style.Triggers>
                                        <!--  "Not entered" is a placeholder, not a value.  -->
                                        <DataTrigger Binding="{Binding HasNotes, Mode=OneWay}" Value="False">
                                            <Setter Property="FontWeight" Value="Normal" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Border
                            Grid.Column="0"
                            Grid.Row="6"
                            Grid.ColumnSpan="2"
                            Style="{StaticResource DividerStyle}" />
                        <TextBlock
                            Grid.Column="0"
                            Grid.Row="7"
                            Grid.ColumnSpan="2"
                            Style="{StaticResource SummarySectionTextStyle}"
                            Text="{loc:Text Summary_Board}" />
                        <TextBlock
                            Grid.Column="0"
                            Grid.Row="8"
                            Style="{StaticResource SummaryLabelTextStyle}"
                            Text="{loc:Text Summary_Quantity}" />
                        <TextBlock
                            Grid.Row="8"
                            Grid.Column="1"
                            Style="{StaticResource SummaryValueTextStyle}"
                            Text="{Binding QuantityText, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="0"
                            Grid.Row="9"
                            Style="{StaticResource SummaryLabelTextStyle}"
                            Text="{loc:Text Order_SizeAndLayers}" />
                        <TextBlock
                            Grid.Row="9"
                            Grid.Column="1"
                            Style="{StaticResource SummaryValueTextStyle}"
                            Text="{Binding BoardSpecificationText, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="0"
                            Grid.Row="10"
                            Style="{StaticResource SummaryLabelTextStyle}"
                            Text="{loc:Text Summary_Material}" />
                        <TextBlock
                            Grid.Row="10"
                            Grid.Column="1"
                            Style="{StaticResource SummaryValueTextStyle}"
                            Text="{Binding MaterialName, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="0"
                            Grid.Row="11"
                            Style="{StaticResource SummaryLabelTextStyle}"
                            Text="{loc:Text Summary_SolderMask}" />
                        <StackPanel
                            Grid.Row="11"
                            Grid.Column="1"
                            Margin="0,0,0,10"
                            Orientation="Horizontal">
                            <Border Background="{Binding SolderMaskHexColor, Mode=OneWay}" Style="{StaticResource ColorSwatchStyle}" />
                            <TextBlock
                                Margin="0"
                                VerticalAlignment="Center"
                                Style="{StaticResource SummaryValueTextStyle}"
                                Text="{Binding SolderMaskText, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="0"
                            Grid.Row="12"
                            Margin="0,0,16,14"
                            Style="{StaticResource SummaryLabelTextStyle}"
                            Text="{loc:Text Summary_BoardThickness}" />
                        <TextBlock
                            Grid.Row="12"
                            Grid.Column="1"
                            Margin="0,0,0,14"
                            Style="{StaticResource SummaryValueTextStyle}"
                            Text="{Binding BoardThicknessText, Mode=OneWay}" />
                    </Grid>
                </Border>

                <!--  Price and production time, from the shared pricing service  -->
                <Border
                    Grid.Row="1"
                    Grid.Column="2"
                    Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.ColumnSpan="2"
                            Style="{StaticResource SectionHeaderTextStyle}"
                            Text="{loc:Text Summary_PricingAndProduction}" />
                        <TextBlock
                            Grid.Column="0"
                            Grid.Row="1"
                            Style="{StaticResource SummaryLabelTextStyle}"
                            Text="{loc:Text Summary_EstimatedUnitPrice}" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource SummaryValueTextStyle}">
                            <Run Text="{Binding EstimatedUnitPriceText, Mode=OneWay}" />
                            <Run Text=" × " />
                            <Run Text="{Binding QuantityText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock
                            Grid.Row="2"
                            Style="{StaticResource SummaryLabelTextStyle}"
                            Text="{loc:Text Summary_EstimatedProductionTime}" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            Style="{StaticResource SummaryValueTextStyle}"
                            Text="{Binding EstimatedProductionTimeText, Mode=OneWay}" />
                        <Border
                            Grid.Column="0"
                            Grid.Row="3"
                            Grid.ColumnSpan="2"
                            Style="{StaticResource DividerStyle}" />
                        <TextBlock
                            Grid.Column="0"
                            Grid.Row="4"
                            Style="{StaticResource SummaryTotalLabelTextStyle}"
                            Text="{loc:Text Summary_EstimatedTotal}" />
                        <TextBlock
                            Grid.Row="4"
                            Grid.Column="1"
                            Style="{StaticResource SummaryTotalValueTextStyle}"
                            Text="{Binding EstimatedTotalPriceText, Mode=OneWay}" />
                        <Grid
                            Grid.Column="0"
                            Grid.Row="5"
                            Grid.ColumnSpan="2"
                            Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconMaterial
                                Width="14"
                                Height="14"
                                Margin="0,1,6,0"
                                VerticalAlignment="Top"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Kind="InformationOutline" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="0,0,0,14"
                                Style="{StaticResource HintTextStyle}"
                                Text="{loc:Text Summary_Disclaimer}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="1" Style="{StaticResource FooterBarStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!--
                    Once the order is completed both are replaced by New Order
                -->
                <Button
                    Grid.Column="0"
                    AutomationProperties.Name="{loc:Text Actions_BackToQuote}"
                    Command="{Binding BackToQuoteCommand}">
                    <Button.Style>
                        <Style BasedOn="{StaticResource SecondaryButtonStyle}" TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOrderCompleted, Mode=OneWay}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial
                            Margin="0,0,8,0"
                            Kind="ArrowLeft"
                            Style="{StaticResource ButtonIconStyle}" />
                        <TextBlock VerticalAlignment="Center" Text="{loc:Text Actions_BackToQuote}" />
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="0"
                    AutomationProperties.Name="{loc:Text Actions_NewOrder}"
                    Command="{Binding NewOrderCommand}">
                    <Button.Style>
                        <Style BasedOn="{StaticResource PrimaryButtonStyle}" TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOrderCompleted, Mode=OneWay}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial
                            Margin="0,0,8,0"
                            Kind="Plus"
                            Style="{StaticResource ButtonIconStyle}" />
                        <TextBlock VerticalAlignment="Center" Text="{loc:Text Actions_NewOrder}" />
                    </StackPanel>
                </Button>
                <!--  Disabled while the confirmation is open (the async command is running).  -->
                <Button
                    Grid.Column="2"
                    AutomationProperties.Name="{loc:Text Actions_PlaceOrder}"
                    Command="{Binding PlaceOrderCommand}">
                    <Button.Style>
                        <Style BasedOn="{StaticResource PrimaryButtonStyle}" TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOrderCompleted, Mode=OneWay}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial
                            Margin="0,0,8,0"
                            Kind="ClipboardCheckOutline"
                            Style="{StaticResource ButtonIconStyle}" />
                        <TextBlock VerticalAlignment="Center" Text="{loc:Text Actions_PlaceOrder}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
