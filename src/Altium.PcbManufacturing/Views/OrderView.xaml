<UserControl
    x:Class="Altium.PcbManufacturing.Views.OrderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Altium.PcbManufacturing.Views.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:loc="clr-namespace:Altium.PcbManufacturing.Views.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Altium.PcbManufacturing.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:OrderViewModel}"
    d:DesignHeight="640"
    d:DesignWidth="960"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="OrderView.Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--  Scrolling content; the navigation footer (Place Order, New Order) belongs to the main window.  -->
    <ScrollViewer
        Focusable="False"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid Margin="{StaticResource PageMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="400" />
                <ColumnDefinition Width="{StaticResource ColumnGap}" />
                <ColumnDefinition Width="2*" MinWidth="300" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Margin="{StaticResource CardGapMargin}"
                AutomationProperties.LiveSetting="Polite"
                AutomationProperties.Name="{loc:Text Order_PlacedTitle}"
                Style="{StaticResource OrderPlacedBannerStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <iconPacks:PackIconMaterial
                        Width="24"
                        Height="24"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource AccentTextBrush}"
                        Kind="CheckCircleOutline" />
                    <StackPanel Grid.Column="1">
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Text="{loc:Text Order_PlacedTitle}" />
                        <TextBlock
                            Margin="0,2,0,0"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="{loc:Text Order_PlacedMessage}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  The project, delivery and board, from the draft.  -->
            <Border
                Grid.Row="1"
                Grid.Column="0"
                Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Style="{StaticResource SectionHeaderTextStyle}"
                        Text="{loc:Text Order_Summary}" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Style="{StaticResource HintTextStyle}"
                        Text="{loc:Text Order_ReviewHint}" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Style="{StaticResource SummarySectionTextStyle}"
                        Text="{loc:Text Summary_Project}" />
                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        Style="{StaticResource SummaryLabelTextStyle}"
                        Text="{loc:Text Summary_ProjectName}" />
                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="1"
                        Style="{StaticResource SummaryValueTextStyle}"
                        Text="{Binding Draft.ProjectName, Mode=OneWay}" />
                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        Style="{StaticResource SummaryLabelTextStyle}"
                        Text="{loc:Text Order_DeliveryPostcode}" />
                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="1"
                        Style="{StaticResource SummaryValueTextStyle}"
                        Text="{Binding Draft.Postcode, Mode=OneWay}" />
                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="0"
                        Style="{StaticResource SummaryLabelTextStyle}"
                        Text="{loc:Text Preferences_Notes}" />
                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="1"
                        Style="{StaticResource NotesValueTextStyle}" />

                    <Border
                        Grid.Row="6"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Style="{StaticResource DividerStyle}" />
                    <TextBlock
                        Grid.Row="7"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Style="{StaticResource SummarySectionTextStyle}"
                        Text="{loc:Text Summary_Board}" />
                    <TextBlock
                        Grid.Row="8"
                        Grid.Column="0"
                        Style="{StaticResource SummaryLabelTextStyle}"
                        Text="{loc:Text Summary_Quantity}" />
                    <TextBlock
                        Grid.Row="8"
                        Grid.Column="1"
                        Style="{StaticResource SummaryValueTextStyle}"
                        Text="{loc:Format Boards_Format,
                                          Path=Draft.Quantity}" />
                    <TextBlock
                        Grid.Row="9"
                        Grid.Column="0"
                        Style="{StaticResource SummaryLabelTextStyle}"
                        Text="{loc:Text Order_SizeAndLayers}" />
                    <TextBlock
                        Grid.Row="9"
                        Grid.Column="1"
                        Style="{StaticResource SummaryValueTextStyle}"
                        Text="{Binding BoardSpecificationText, Mode=OneWay}" />
                    <TextBlock
                        Grid.Row="10"
                        Grid.Column="0"
                        Style="{StaticResource SummaryLabelTextStyle}"
                        Text="{loc:Text Summary_Material}" />
                    <TextBlock
                        Grid.Row="10"
                        Grid.Column="1"
                        Style="{StaticResource SummaryValueTextStyle}"
                        Text="{Binding Draft.SelectedMaterial.Name, Mode=OneWay}" />
                    <TextBlock
                        Grid.Row="11"
                        Grid.Column="0"
                        Style="{StaticResource SummaryLabelTextStyle}"
                        Text="{loc:Text Summary_SolderMask}" />
                    <StackPanel
                        Grid.Row="11"
                        Grid.Column="1"
                        Margin="0,0,0,10"
                        Orientation="Horizontal">
                        <Border Background="{Binding Draft.SelectedSolderMaskColor.HexColor, Mode=OneWay}" Style="{StaticResource ColorSwatchStyle}" />
                        <TextBlock
                            Margin="0"
                            VerticalAlignment="Center"
                            Style="{StaticResource SummaryValueTextStyle}"
                            Text="{loc:CatalogName SolderMaskColor,
                                                   IdPath=Draft.SelectedSolderMaskColor.Id,
                                                   NamePath=Draft.SelectedSolderMaskColor.Name}" />
                    </StackPanel>
                    <TextBlock
                        Grid.Row="12"
                        Grid.Column="0"
                        Margin="0,0,16,14"
                        Style="{StaticResource SummaryLabelTextStyle}"
                        Text="{loc:Text Summary_BoardThickness}" />
                    <TextBlock
                        Grid.Row="12"
                        Grid.Column="1"
                        Margin="0,0,0,14"
                        Style="{StaticResource SummaryValueTextStyle}"
                        Text="{loc:Format Thickness_Millimeters,
                                          Path=Draft.SelectedBoardThickness.Millimeters}" />
                </Grid>
            </Border>

            <!--  Price and production time, calculated by the draft  -->
            <Border
                Grid.Row="1"
                Grid.Column="2"
                Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Style="{StaticResource SectionHeaderTextStyle}"
                        Text="{loc:Text Summary_PricingAndProduction}" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Style="{StaticResource SummaryLabelTextStyle}"
                        Text="{loc:Text Summary_EstimatedUnitPrice}" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource SummaryValueTextStyle}">
                        <Run Text="{Binding Draft.PriceEstimate.EstimatedUnitPrice, Mode=OneWay, Converter={converters:UsdConverter}}" />
                        <Run Text=" × " />
                        <Run Text="{loc:Format Boards_Format, Path=Draft.Quantity}" />
                    </TextBlock>
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Style="{StaticResource SummaryLabelTextStyle}"
                        Text="{loc:Text Summary_EstimatedProductionTime}" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="1"
                        Style="{StaticResource SummaryValueTextStyle}"
                        Text="{loc:Format Days_Format,
                                          Path=Draft.ProductionDays}" />
                    <Border
                        Grid.Row="3"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Style="{StaticResource DividerStyle}" />
                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        Style="{StaticResource SummaryTotalLabelTextStyle}"
                        Text="{loc:Text Summary_EstimatedTotal}" />
                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="1"
                        Style="{StaticResource SummaryTotalValueTextStyle}"
                        Text="{Binding Draft.TotalPrice, Mode=OneWay, Converter={converters:UsdConverter}}" />
                    <Grid
                        Grid.Row="5"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <iconPacks:PackIconMaterial
                            Width="14"
                            Height="14"
                            Margin="0,1,6,0"
                            VerticalAlignment="Top"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Kind="InformationOutline" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="0,0,0,14"
                            Style="{StaticResource HintTextStyle}"
                            Text="{loc:Text Summary_Disclaimer}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
