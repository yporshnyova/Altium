<!--
    QuoteView resources: the templates of the grouped, read-only parameter table. Merged through UserControl.Resources;
    the shared size scope that aligns the label column across groups is set on the table's container in the view.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:Altium.PcbManufacturing.ViewModels">

    <!--  One parameter: label and value, with a colour swatch for colour values.  -->
    <DataTemplate x:Key="ParameterRowTemplate" DataType="{x:Type vm:QuoteParameter}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="Auto"
                    MinWidth="160"
                    SharedSizeGroup="ParameterLabel" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource SummaryLabelTextStyle}" Text="{Binding Label, Mode=OneWay}" />
            <StackPanel
                Grid.Column="1"
                Margin="0,0,0,10"
                Orientation="Horizontal">
                <Border
                    x:Name="Swatch"
                    Background="{Binding SwatchHexColor, Mode=OneWay}"
                    Style="{StaticResource ColorSwatchStyle}"
                    Visibility="Collapsed" />
                <TextBlock
                    Margin="0"
                    VerticalAlignment="Center"
                    Style="{StaticResource SummaryValueTextStyle}"
                    Text="{Binding Value, Mode=OneWay}" />
            </StackPanel>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding HasSwatch, Mode=OneTime}" Value="True">
                <Setter TargetName="Swatch" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!--  One group: title and its parameters, with a divider above every group except the first.  -->
    <DataTemplate x:Key="ParameterGroupTemplate" DataType="{x:Type vm:QuoteParameterGroup}">
        <StackPanel>
            <Border x:Name="GroupDivider" Style="{StaticResource DividerStyle}" />
            <TextBlock Style="{StaticResource SummarySectionTextStyle}" Text="{Binding Title, Mode=OneWay}" />
            <ItemsControl
                Focusable="False"
                ItemTemplate="{StaticResource ParameterRowTemplate}"
                ItemsSource="{Binding Parameters, Mode=OneTime}" />
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                <Setter TargetName="GroupDivider" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
