<!--
    PreferencesView resources: the form's field, validation and surcharge styles, the summary's state-dependent values
    and the board thickness option template. Merged through UserControl.Resources; the implicit TextBox and ComboBox
    styles, spacing tokens and summary typography they build on come from the application resources.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Altium.PcbManufacturing.Views.Converters"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:loc="clr-namespace:Altium.PcbManufacturing.Views.Markup"
    xmlns:models="clr-namespace:Altium.PcbManufacturing.Models">

    <!--  Form fields  -->
    <Style x:Key="FieldLabelStyle" TargetType="Label">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,16,14" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style
        x:Key="FieldComboBoxStyle"
        BasedOn="{StaticResource {x:Type ComboBox}}"
        TargetType="ComboBox">
        <Setter Property="Margin" Value="{StaticResource FieldMargin}" />
    </Style>

    <Style
        x:Key="FieldTextBoxStyle"
        BasedOn="{StaticResource {x:Type TextBox}}"
        TargetType="TextBox">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Margin" Value="{StaticResource FieldMargin}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <!--  The default error template draws the red outline; the message itself is shown as text below the field.  -->
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="ToolTip" Value="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  Shows the first validation error of the input element given as Tag, with an icon; collapsed while it is valid.  -->
    <Style x:Key="ValidationMessageStyle" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
        <Setter Property="Margin" Value="0,-8,0,14" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="AutomationProperties.LiveSetting" Value="Assertive" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Tag.(Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <iconPacks:PackIconMaterial
                            Width="14"
                            Height="14"
                            Margin="0,1,6,0"
                            VerticalAlignment="Top"
                            Kind="AlertCircleOutline" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding Tag.(Validation.Errors)/ErrorContent, RelativeSource={RelativeSource TemplatedParent}}"
                            TextWrapping="Wrap" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag.(Validation.HasError), RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SurchargeTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="12,0,0,14" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>

    <!--  The selected material's extra cost per board next to its selector, e.g. "+$37.25 / board", or "Included".  -->
    <Style
        x:Key="MaterialSurchargeFieldTextStyle"
        BasedOn="{StaticResource SurchargeTextStyle}"
        TargetType="TextBlock">
        <Setter Property="Text" Value="{loc:Format Pricing_SurchargePerBoard, Path=Draft.PriceEstimate.MaterialSurchargePerUnit, Converter={converters:UsdConverter}}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Draft.PriceEstimate.MaterialSurchargePerUnit, Mode=OneWay}" Value="0">
                <Setter Property="Text" Value="{loc:Text Pricing_Included}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="BoardThicknessTemplate" DataType="{x:Type models:BoardThickness}">
        <TextBlock Text="{loc:Format Thickness_Millimeters, Path=Millimeters}" />
    </DataTemplate>

    <!--
        Summary values that state the input's validity. The summary shows the draft; the draft reports no errors, so
        there is no error adorner and the invalid state (from the step's validation) is stated in text instead. Later
        triggers win for Text: a blank value reads "Not entered" even while invalid.
    -->
    <Style
        x:Key="ProjectNameSummaryValueTextStyle"
        BasedOn="{StaticResource SummaryValueTextStyle}"
        TargetType="TextBlock">
        <Setter Property="Text" Value="{Binding Draft.ProjectName, Mode=OneWay}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasProjectNameErrors, Mode=OneWay}" Value="True">
                <Setter Property="Text" Value="{loc:Format Summary_InvalidValue, Path=Draft.ProjectName}" />
                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsProjectNameBlank, Mode=OneWay}" Value="True">
                <Setter Property="Text" Value="{loc:Text Summary_NotEntered}" />
                <Setter Property="FontWeight" Value="Normal" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style
        x:Key="PostcodeSummaryValueTextStyle"
        BasedOn="{StaticResource SummaryValueTextStyle}"
        TargetType="TextBlock">
        <Setter Property="Text" Value="{Binding Draft.Postcode, Mode=OneWay}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasPostcodeErrors, Mode=OneWay}" Value="True">
                <Setter Property="Text" Value="{loc:Format Summary_InvalidValue, Path=Draft.Postcode}" />
                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsPostcodeBlank, Mode=OneWay}" Value="True">
                <Setter Property="Text" Value="{loc:Text Summary_NotEntered}" />
                <Setter Property="FontWeight" Value="Normal" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style
        x:Key="QuantitySummaryValueTextStyle"
        BasedOn="{StaticResource SummaryValueTextStyle}"
        TargetType="TextBlock">
        <Setter Property="Text" Value="{loc:Format Boards_Format, Path=Draft.Quantity}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasQuantityErrors, Mode=OneWay}" Value="True">
                <Setter Property="Text" Value="{loc:Format Summary_InvalidValue, Path=QuantityInput}" />
                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsQuantityBlank, Mode=OneWay}" Value="True">
                <Setter Property="Text" Value="{loc:Text Summary_NotEntered}" />
                <Setter Property="FontWeight" Value="Normal" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  While the quantity is invalid there is no total to show.  -->
    <Style
        x:Key="EstimatedTotalSummaryValueTextStyle"
        BasedOn="{StaticResource SummaryTotalValueTextStyle}"
        TargetType="TextBlock">
        <Setter Property="Text" Value="{Binding Draft.TotalPrice, Mode=OneWay, Converter={converters:UsdConverter}}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasQuantityErrors, Mode=OneWay}" Value="True">
                <Setter Property="Text" Value="—" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
