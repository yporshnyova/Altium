<Window
    x:Class="Altium.PcbManufacturing.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:Altium.PcbManufacturing.Views.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:loc="clr-namespace:Altium.PcbManufacturing.Views.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Altium.PcbManufacturing.ViewModels"
    Title="{loc:Text App_Title}"
    Width="1024"
    Height="800"
    MinWidth="840"
    MinHeight="520"
    d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
    Background="{DynamicResource WindowBackgroundBrush}"
    FontFamily="Segoe UI"
    FontSize="13"
    Foreground="{DynamicResource TextPrimaryBrush}"
    Icon="pack://application:,,,/Altium.PcbManufacturing;component/Icons/pcb-manufacturing.ico"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="MainWindow.Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!--  Header: application title on the left, language and theme on the right (available on every tab).  -->
        <Border DockPanel.Dock="Top" Style="{StaticResource HeaderBarStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Style="{StaticResource AppTitleTextStyle}" Text="{loc:Text App_Title}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <iconPacks:PackIconMaterial
                        Margin="0,0,8,0"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Kind="Translate"
                        Style="{StaticResource HeaderIconStyle}" />
                    <ComboBox
                        MinWidth="72"
                        AutomationProperties.Name="{loc:Text Header_Language}"
                        DisplayMemberPath="Code"
                        ItemsSource="{Binding Languages, Mode=OneTime}"
                        SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                        ToolTip="{loc:Text Header_Language}">
                        <ComboBox.ItemContainerStyle>
                            <Style BasedOn="{StaticResource {x:Type ComboBoxItem}}" TargetType="ComboBoxItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding NativeName, Mode=OneTime}" />
                                <Setter Property="ToolTip" Value="{Binding NativeName, Mode=OneTime}" />
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>

                    <!--  The icon, tooltip and accessible name come from the style and follow the current theme.  -->
                    <Button
                        Margin="12,0,0,0"
                        Command="{Binding ToggleThemeCommand}"
                        Style="{StaticResource ThemeToggleButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--
            The selected tab is the wizard's current step: each TabItem's Tag is its step, selected through SelectedValue.
            The wizard decides: a tab is enabled only while its step is available (unlocked, Preferences valid, no
            confirmation pending, and the order not yet completed), and SelectionFollowsSourceBehavior returns the
            selection to the current step if the wizard refuses a change.
        -->
        <TabControl
            Margin="12,12,12,12"
            behaviors:SelectionFollowsSourceBehavior.IsEnabled="True"
            DataContext="{Binding Wizard, Mode=OneTime}"
            SelectedValue="{Binding CurrentStep, Mode=TwoWay}"
            SelectedValuePath="Tag">
            <!--
                Every step's view (resolved from Resources/Templates/Mappings.xaml) sits above the wizard's one navigation
                footer. The footer's actions and texts come from the wizard; on Preferences, where there is no Back, its
                left side holds that step's own Reset to Defaults.
            -->
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <DockPanel>
                        <Border
                            DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TabControl}}"
                            DockPanel.Dock="Bottom"
                            Style="{StaticResource FooterBarStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Grid.Column="0"
                                    AutomationProperties.Name="{Binding BackActionText}"
                                    Command="{Binding BackCommand}"
                                    Style="{StaticResource BackButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial
                                            Margin="0,0,8,0"
                                            Kind="ArrowLeft"
                                            Style="{StaticResource ButtonIconStyle}" />
                                        <TextBlock VerticalAlignment="Center" Text="{Binding BackActionText}" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Grid.Column="0"
                                    AutomationProperties.Name="{loc:Text Actions_ResetToDefaults}"
                                    Command="{Binding Preferences.ResetToDefaultsCommand}"
                                    Style="{StaticResource ResetToDefaultsButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial
                                            Margin="0,0,8,0"
                                            Kind="Restore"
                                            Style="{StaticResource ButtonIconStyle}" />
                                        <TextBlock VerticalAlignment="Center" Text="{loc:Text Actions_ResetToDefaults}" />
                                    </StackPanel>
                                </Button>
                                <!--  Disabled while the order confirmation is open.  -->
                                <Button
                                    Grid.Column="2"
                                    AutomationProperties.Name="{Binding PrimaryActionText}"
                                    Command="{Binding PrimaryActionCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <!--  Place Order and New Order lead with an icon; the other actions point forward.  -->
                                        <iconPacks:PackIconMaterial Margin="0,0,8,0" Style="{StaticResource PrimaryActionLeadingIconStyle}" />
                                        <TextBlock VerticalAlignment="Center" Text="{Binding PrimaryActionText}" />
                                        <iconPacks:PackIconMaterial
                                            Margin="8,0,0,0"
                                            Kind="ArrowRight"
                                            Style="{StaticResource PrimaryActionTrailingIconStyle}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                        <!--
                            The step view model itself is validated (INotifyDataErrorInfo); its errors are shown by the
                            step's own fields, so this whole-object binding must not frame the content in red.
                        -->
                        <ContentPresenter Content="{Binding ValidatesOnNotifyDataErrors=False}" />
                    </DockPanel>
                </DataTemplate>
            </TabControl.ContentTemplate>
            <TabItem
                AutomationProperties.Name="{loc:Text Tab_Preferences}"
                Content="{Binding Preferences, Mode=OneTime}"
                IsEnabled="{Binding IsPreferencesAvailable}"
                Style="{StaticResource EditableStepTabItemStyle}"
                Tag="{x:Static vm:WorkflowStep.Preferences}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="CogOutline" Style="{StaticResource TabIconStyle}" />
                        <TextBlock VerticalAlignment="Center" Text="{loc:Text Tab_Preferences}" />
                        <iconPacks:PackIconMaterial Style="{StaticResource StepCompletedIconStyle}" Tag="{Binding IsPreferencesCompleted}" />
                    </StackPanel>
                </TabItem.Header>
            </TabItem>
            <TabItem
                AutomationProperties.Name="{loc:Text Tab_Quote}"
                Content="{Binding Quote, Mode=OneTime}"
                IsEnabled="{Binding IsQuoteAvailable}"
                Style="{StaticResource EditableStepTabItemStyle}"
                Tag="{x:Static vm:WorkflowStep.Quote}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="FileDocumentOutline" Style="{StaticResource TabIconStyle}" />
                        <TextBlock VerticalAlignment="Center" Text="{loc:Text Tab_Quote}" />
                        <iconPacks:PackIconMaterial Style="{StaticResource StepCompletedIconStyle}" Tag="{Binding IsQuoteCompleted}" />
                    </StackPanel>
                </TabItem.Header>
            </TabItem>
            <TabItem
                AutomationProperties.Name="{loc:Text Tab_Order}"
                Content="{Binding Order, Mode=OneTime}"
                IsEnabled="{Binding IsOrderAvailable}"
                Tag="{x:Static vm:WorkflowStep.Order}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="ClipboardCheckOutline" Style="{StaticResource TabIconStyle}" />
                        <TextBlock VerticalAlignment="Center" Text="{loc:Text Tab_Order}" />
                        <iconPacks:PackIconMaterial Style="{StaticResource StepCompletedIconStyle}" Tag="{Binding IsCompleted}" />
                    </StackPanel>
                </TabItem.Header>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
