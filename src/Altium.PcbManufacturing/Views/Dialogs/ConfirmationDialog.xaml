<Window
    x:Class="Altium.PcbManufacturing.Views.Dialogs.ConfirmationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:loc="clr-namespace:Altium.PcbManufacturing.Views.Markup"
    Width="420"
    Background="{DynamicResource CardBackgroundBrush}"
    FontFamily="Segoe UI"
    FontSize="13"
    Foreground="{DynamicResource TextPrimaryBrush}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterOwner">
    <!--  A themed, localized Yes/No confirmation; "No" has focus and Esc cancels, so the safe answer is the default.  -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="20,20,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <iconPacks:PackIconMaterial
                Width="24"
                Height="24"
                Margin="0,0,14,0"
                VerticalAlignment="Top"
                Foreground="{DynamicResource AccentTextBrush}"
                Kind="InformationOutline" />
            <TextBlock
                x:Name="MessageText"
                Grid.Column="1"
                VerticalAlignment="Center"
                TextWrapping="Wrap" />
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource FooterBarStyle}">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    MinWidth="96"
                    Margin="0,0,8,0"
                    Click="OnYesClick"
                    Content="{loc:Text Dialog_Yes}"
                    Style="{StaticResource PrimaryButtonStyle}" />
                <Button
                    x:Name="NoButton"
                    MinWidth="96"
                    Content="{loc:Text Dialog_No}"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
